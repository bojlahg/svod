# ── mozg, self-hosted ────────────────────────────────────────────────────
#
#   cp .env.selfhost.example .env
#   docker compose -f docker-compose.selfhost.yml up -d
#
# Then open http://localhost:3300. Only the three values marked REQUIRED
# actually need your attention. No model key is needed to boot, read or
# search — the app serves while embedding weights download.

# REQUIRED — the self-host administrator. Created on first boot; changing the
# password and recreating the app rotates it (old sessions are dropped).
# Left blank on purpose: set a deliberate password before the first boot.
MOZG_ADMIN_EMAIL=you@example.com
MOZG_ADMIN_PASSWORD=
# If the password contains $ or other special characters, wrap it in single
# quotes so it stays literal: MOZG_ADMIN_PASSWORD='p@$$w0rd!'
# (Compose would otherwise treat $.. as variable interpolation.)

# REQUIRED — session signing. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Optional — only needed for AI reading/exams. Anthropic by default; any
# Anthropic-compatible reseller works via ANTHROPIC_BASE_URL. Users can also
# bring their own key per account in settings (including OpenAI, Kimi,
# DeepSeek, Qwen and GLM). Leave empty to sign in, read and search existing
# notes. The legacy source extraction and exams require a key.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.apimart.ai

# Where this instance lives. Keep as-is for local use. For a NAS or another
# host, set both to the address browsers actually open (include a nondefault
# port when you mapped one, e.g. http://nas.local:3300).
BETTER_AUTH_URL=http://localhost:3300
NEXT_PUBLIC_APP_URL=http://localhost:3300

# Cheap and good for reading docs. Swap for claude-sonnet-5 if you would
# rather pay more for slightly better extraction.
MODEL_EXTRACT=claude-haiku-4-5-20251001
MODEL_JUDGE=claude-haiku-4-5-20251001

# Local database and storage — the compose file wires these up for you.
POSTGRES_PASSWORD=mozg
STORAGE_DRIVER=local

# Optional. Without mail, password sign-up is closed and the first account
# is the administrator from MOZG_ADMIN_* above (or GitHub OAuth).
# EMAIL_FROM="mozg <hi@example.com>"
# RESEND_API_KEY=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Legacy alias: ADMIN_EMAILS also unlocks /admin, and MOZG_ADMIN_EMAIL is
# always an admin. Keep both only while migrating older installs.
# ADMIN_EMAILS=you@example.com

# After editing .env, recreate the app so it picks the new values up:
#   docker compose -f docker-compose.selfhost.yml up -d
# (A plain `docker compose restart` keeps the old environment.)
