{
  "name": "mozg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/migrate.ts --reset",
    "worker": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/worker/index.mjs && esbuild scripts/migrate.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/migrate.mjs && esbuild scripts/selfhost-start.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/selfhost-start.mjs",
    "worker:prod": "node dist/worker/index.mjs",
    "db:migrate:prod": "node dist/migrate.mjs",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "test": "tsx --test src/lib/*.test.ts src/worker/*.test.ts",
    "auth:migrate": "npx --yes @better-auth/cli migrate --y",
    "check:access": "tsx --env-file-if-exists=.env scripts/check-access.ts",
    "translate": "tsx --env-file-if-exists=.env scripts/translate.ts",
    "i18n:wrap": "tsx scripts/i18n-wrap.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:mcp": "tsx --env-file-if-exists=.env scripts/check-mcp.ts",
    "check:admin-bootstrap": "tsx --env-file-if-exists=.env scripts/check-admin-bootstrap.ts",
    "token": "tsx --env-file-if-exists=.env scripts/token.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "better-auth": "^1.4.0",
    "next": "16.2.10",
    "pg": "^8.13.1",
    "pg-boss": "^10.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
